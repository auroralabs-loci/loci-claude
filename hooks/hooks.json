{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/session-init.sh\"'",
            "timeout": 120,
            "timeoutSec": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/turn-clean.sh\"'",
            "timeout": 15,
            "timeoutSec": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/prompt-submit-turn.sh\"'",
            "timeout": 10,
            "timeoutSec": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/contract-guard.sh\"'",
            "timeout": 5,
            "timeoutSec": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/pre-edit-hook.sh\"'",
            "timeout": 8,
            "timeoutSec": 8,
            "statusMessage": "LOCI — execution-aware analysis..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/post-edit-hook.sh\"'",
            "timeout": 5,
            "timeoutSec": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/post-bash-bypass.sh\"'",
            "timeout": 5,
            "timeoutSec": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/subagent-start.sh\"'",
            "timeout": 5,
            "timeoutSec": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/stats-flush.sh\"'",
            "timeout": 10,
            "timeoutSec": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/draft-pending-nudge.sh\"'",
            "timeout": 10,
            "timeoutSec": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/manifest-status-nudge.sh\"'",
            "timeout": 10,
            "timeoutSec": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'exec bash \"$CLAUDE_PLUGIN_ROOT/hooks/turn-clean.sh\"'",
            "timeout": 10,
            "timeoutSec": 10
          }
        ]
      }
    ]
  }
}
